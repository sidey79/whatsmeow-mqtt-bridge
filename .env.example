# Set this to the MQTT endpoint reachable inside your FHEM Docker network.
MQTT_URL=mqtt://fhem:1883
# MQTT_HOST=mqtt
# MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PROTOCOL_VERSION=3
MQTT_BASE_TOPIC=whatsmeow-mqtt-bridge
MQTT_CLIENT_ID=whatsmeow-mqtt-bridge
WA_DB_PATH=/data/whatsapp_session.db
# Required for image/document commands; comma-separated exact hostnames or IPs.
MEDIA_ALLOWED_HOSTS=example.com
MEDIA_MAX_SIZE_MB=10
LOG_LEVEL=info
HEALTH_PORT=3000
