# Set this to the MQTT endpoint reachable inside your FHEM Docker network.
MQTT_URL=mqtt://fhem:1883
# MQTT_HOST=mqtt
# MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PROTOCOL_VERSION=3
MQTT_BASE_TOPIC=whatsapp
MQTT_CLIENT_ID=whatsmeow_mqtt_bridge
WA_DB_PATH=/data/whatsapp_session.db
# WA_DB_DRIVER=postgres
# WA_DB_HOST=postgres
# WA_DB_PORT=5432
# WA_DB_NAME=fhem
# WA_DB_SCHEMA=whatsmeow
# WA_DB_USER=whatsmeow_bridge
# WA_DB_PASSWORD_FILE=/run/secrets/whatsmeow_db_password
# WA_DB_SSLMODE=disable
# Alternatively: WA_DB_DSN or WA_DB_DSN_FILE
# Required for image/document commands; comma-separated exact hostnames or IPs.
MEDIA_ALLOWED_HOSTS=example.com
MEDIA_MAX_SIZE_MB=10
LOG_LEVEL=info
HEALTH_PORT=3000
